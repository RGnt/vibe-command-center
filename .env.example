POSTGRES_USER=todo_user
POSTGRES_PASSWORD=todo_password
POSTGRES_DB=todo_db
ADMINER_PORT=8081
FRONTEND_PORT=80

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED: Set a strong, random secret for JWT signing (min 32 chars).
# Generate one with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_secret

# BCRYPT_COST defines the work factor for password hashing. Default is 12. Valid range [10, 31].
BCRYPT_COST=12

# Set to "true" if the app is served over HTTPS to enable Secure cookies.
IS_HTTPS=false

# Comma-separated list of allowed CORS origins. Defaults to localhost only.
# Example: https://app.yourdomain.com,https://admin.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
